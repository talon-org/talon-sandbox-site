---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroTerminal from '../components/HeroTerminal.tsx';
---

<Base
  title="Talon Sandbox · 给 AI agent 的计算机"
  description="50 毫秒内拉起隔离 sandbox。把 PTY 流回模型，看它写代码、装依赖、暴露 preview URL —— 全部在你设定的网络策略下。"
>
  <Nav currentPath="/" />

  <!-- ───── HERO ───── -->
  <section class="hero" id="top">
    <div class="container">
      <div class="hero-inner">
        <div class="eyebrow">AGENT SANDBOX RUNTIME</div>
        <h1 class="huge">
          为 AI agent 准备的<br />
          一台 <i class="acc">随用随启</i> 的计算机
        </h1>
        <p class="lead" style="margin-left:auto;margin-right:auto;text-align:center">
          50 毫秒内拉起隔离 sandbox。把 PTY 流回模型，看它写代码、装依赖、暴露 preview URL —— 全部在你设定的网络策略下。
        </p>
        <div class="cta-row">
          <!-- 主 CTA：免费试用 → console（passwordless 注册=登录同一入口） -->
          <a class="btn btn-primary btn-lg" href="https://app.sandbox.talon.net.cn/" rel="noopener">
            免费试用
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <!-- 次级：文档 -->
          <a class="btn btn-lg" href="https://docs.sandbox.talon.net.cn" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 1.5h6L13 5v9a1 1 0 01-1 1H3.5a1 1 0 01-1-1V2.5a1 1 0 011-1z"/><path d="M9 1.5V5h4"/></svg>
            阅读文档
          </a>
        </div>

        <HeroTerminal client:load />

        <div class="meta-row" role="list">
          <span role="listitem">&lt;50ms 冷启动</span>
          <span role="listitem">容器级强隔离</span>
          <span role="listitem">三档网络策略</span>
          <span role="listitem">流式 PTY + 录像</span>
          <span role="listitem">内置 Chromium CDP</span>
          <span role="listitem">Python · TypeScript SDK</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── LOGO WALL ───── -->
  <div class="logo-wall" aria-label="合作团队">
    <div class="container">
      <div class="l-text">已为这些团队的 agent 提供运行时</div>
      <div class="logos-wrap">
        <span class="logo-item"><span class="logo-dot" aria-hidden="true"></span>acme.dev</span>
        <span class="logo-item"><span class="logo-dot" aria-hidden="true" style="border-radius:0;transform:rotate(45deg)"></span>codex labs</span>
        <span class="logo-item"><span class="logo-tri" aria-hidden="true"></span>foundation</span>
        <span class="logo-item"><span class="logo-dot" aria-hidden="true" style="clip-path:polygon(0 0, 100% 50%, 0 100%);border-radius:0"></span>raven ai</span>
        <span class="logo-item">◆ thread.so</span>
        <span class="logo-item">▣ paper inc.</span>
      </div>
    </div>
  </div>

  <!-- ───── VALUES ───── -->
  <section class="values-section" id="values">
    <div class="container">
      <div class="eyebrow" style="display:block;text-align:center;margin-bottom:18px">为什么是 Talon Sandbox</div>
      <h2 class="big" style="text-align:center">三件事，我们做到极致。</h2>
      <p class="lead" style="text-align:center;margin:0 auto 56px">
        不卖功能堆砌。Talon Sandbox 只在三件事上拼命：启动快、隔离稳、过程透明。
      </p>
      <div class="values-grid">
        <article class="value-card">
          <div class="v-ix" aria-hidden="true">01</div>
          <div class="v-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 1L3 9h4l-1 6 6-8H8l1-6z"/>
            </svg>
          </div>
          <h3>&lt;50ms 冷启动</h3>
          <p>agent 调用 <code>Sandbox.create()</code>，sandbox 已经在那等它。容器走 warm pool 预热，从空闲到可写入文件只要几十毫秒。</p>
          <div class="v-meta">实测 P95 · <strong>≈30 ms</strong> · runc 容器</div>
        </article>

        <article class="value-card">
          <div class="v-ix" aria-hidden="true">02</div>
          <div class="v-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2l5 1.5v4c0 2.8-2.2 5.4-5 6-2.8-.6-5-3.2-5-6V3.5L8 2z"/>
            </svg>
          </div>
          <h3>容器级强隔离</h3>
          <p>每个 sandbox 是独立 OCI 容器，拥有自己的 PID namespace、文件系统、网络栈和 cgroup 资源限额。出站走三档网络策略（全放行 / 白名单 / 完全封锁），AI 写出来的任何代码都跑在它自己的笼子里。</p>
          <div class="v-meta">命名空间隔离 · cgroup 限额 · <strong>出站策略可控</strong></div>
        </article>

        <article class="value-card">
          <div class="v-ix" aria-hidden="true">03</div>
          <div class="v-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2.5" width="12" height="11" rx="1"/>
              <path d="M5 2.5v11M11 2.5v11M2 5.5h3M2 8h3M2 10.5h3M11 5.5h3M11 8h3M11 10.5h3"/>
            </svg>
          </div>
          <h3>流式 PTY + 全程录像</h3>
          <p>PTY 数据帧实时回流到你的模型。每个会话自动录像为可回放、可审计的 .cast 文件 —— agent 写错代码时你能精确回到那一帧。</p>
          <div class="v-meta">支持 asciinema · <strong>tamper-evident</strong> chain</div>
        </article>
      </div>
    </div>
  </section>

  <!-- ───── SHOWCASE ───── -->
  <section class="showcase-section">
    <div class="container-wide">
      <div class="showcase-row">
        <div class="showcase-copy">
          <div class="eyebrow">控制台</div>
          <h2 class="big">为工程师做的界面，<br />不是为周报。</h2>
          <p class="lead">
            每个 sandbox 的状态、进程、端口、文件、网络流量、审计事件，一屏看完。⌘K 跳到任何地方。
          </p>
          <ul class="feature-list" role="list">
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>
              <span><b>实时指标</b><span class="desc">CPU / 内存 / 出站流量按秒滚动，数字直接动起来</span></span>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>
              <span><b>8 档状态机</b><span class="desc">从 provisioning 到 evicted，每一档都有自己的呼吸节奏</span></span>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>
              <span><b>cmd-k 命令栏</b><span class="desc">键盘优先 · 跳转、操作、搜索从不离开主屏</span></span>
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>
              <span><b>深浅双色</b><span class="desc">8 套配色 · 紧凑 / 标准 / 宽松三档密度 · 一套字体可换</span></span>
            </li>
          </ul>
          <div style="margin-top:32px">
            <a class="btn btn-lg" href="https://playground.sandbox.talon.net.cn" target="_blank" rel="noopener">
              查看 Playground
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2.5h4.5V7M13.5 2.5L7.5 8.5"/></svg>
            </a>
          </div>
        </div>

        <!-- Dashboard mock -->
        <div class="mock-frame" role="img" aria-label="Talon Sandbox 控制台预览截图">
          <div class="mock-side">
            <div class="mock-brand">
              <span class="mock-mark" aria-hidden="true"></span>
              <span class="mock-wm">talon sandbox</span>
            </div>
            <div>
              <div class="mock-lbl">工作区</div>
              <nav class="mock-nav">
                <div class="mock-nav-item mock-nav-on"><span class="mock-dot mock-dot-acc"></span>仪表盘</div>
                <div class="mock-nav-item"><span class="mock-dot"></span>沙箱</div>
                <div class="mock-nav-item"><span class="mock-dot"></span>录像</div>
                <div class="mock-nav-item"><span class="mock-dot"></span>凭据</div>
                <div class="mock-nav-item"><span class="mock-dot"></span>审计</div>
              </nav>
            </div>
            <div>
              <div class="mock-lbl">管理</div>
              <nav class="mock-nav">
                <div class="mock-nav-item"><span class="mock-dot"></span>节点</div>
                <div class="mock-nav-item"><span class="mock-dot"></span>租户</div>
              </nav>
            </div>
          </div>
          <div class="mock-main">
            <div class="mock-header">
              <span class="mock-title">仪表盘</span>
              <button class="mock-btn-new" tabindex="-1" aria-hidden="true">+ 新 sandbox</button>
            </div>
            <div class="mock-stats-grid">
              <div class="mock-stat">
                <span class="mock-stat-k">运行中</span>
                <span class="mock-stat-v">18</span>
                <svg class="mock-spark" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 14 L10 12 L20 13 L30 8 L40 10 L50 6 L60 7 L70 4 L80 5 L90 3 L100 4" fill="none" stroke="var(--acc-strong)" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
                </svg>
              </div>
              <div class="mock-stat">
                <span class="mock-stat-k">vCPU</span>
                <span class="mock-stat-v">14.8<span class="mock-unit">/48</span></span>
                <svg class="mock-spark" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 10 L10 8 L20 12 L30 11 L40 7 L50 9 L60 6 L70 8 L80 5 L90 7 L100 4" fill="none" stroke="var(--acc-strong)" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
                </svg>
              </div>
              <div class="mock-stat">
                <span class="mock-stat-k">内存</span>
                <span class="mock-stat-v">42<span class="mock-unit">GiB</span></span>
                <svg class="mock-spark" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 12 L10 10 L20 11 L30 9 L40 8 L50 9 L60 7 L70 5 L80 6 L90 4 L100 5" fill="none" stroke="var(--info)" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
                </svg>
              </div>
              <div class="mock-stat">
                <span class="mock-stat-k">出站</span>
                <span class="mock-stat-v">1.7<span class="mock-unit">MB/s</span></span>
                <svg class="mock-spark" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 8 L10 10 L20 7 L30 11 L40 9 L50 13 L60 10 L70 14 L80 12 L90 15 L100 13" fill="none" stroke="var(--info)" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
                </svg>
              </div>
            </div>
            <div class="mock-table">
              <div class="mock-row mock-row-head">
                <div>SANDBOX</div><div>镜像</div><div>运行时长</div><div>状态</div>
              </div>
              <div class="mock-row">
                <div class="mock-cell-id"><span class="mock-status-dot mock-status-ok"></span>sb_42a1</div>
                <div class="mock-mono">node:20-bookworm</div>
                <div class="mock-mono">12m 04s</div>
                <div><span class="mock-badge mock-badge-ok">● 运行中</span></div>
              </div>
              <div class="mock-row">
                <div class="mock-cell-id"><span class="mock-status-dot mock-status-ok"></span>sb_9c0e</div>
                <div class="mock-mono">python:3.12-slim</div>
                <div class="mock-mono">02m 14s</div>
                <div><span class="mock-badge mock-badge-ok">● 运行中</span></div>
              </div>
              <div class="mock-row">
                <div class="mock-cell-id"><span class="mock-status-dot mock-status-idle"></span>sb_71f3</div>
                <div class="mock-mono">ubuntu:24.04</div>
                <div class="mock-mono">1h 02m</div>
                <div><span class="mock-badge mock-badge-idle">● 空闲</span></div>
              </div>
              <div class="mock-row">
                <div class="mock-cell-id"><span class="mock-status-dot mock-status-fail"></span>sb_5b8d</div>
                <div class="mock-mono">custom-ai:latest</div>
                <div class="mock-mono">3m 41s</div>
                <div><span class="mock-badge mock-badge-fail">● 失败</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── HOW IT WORKS ───── -->
  <section class="how-section" id="how">
    <div class="container">
      <div class="eyebrow" style="display:block;text-align:center;margin-bottom:18px">3 步接入</div>
      <h2 class="big" style="text-align:center;margin-bottom:56px">从注册到第一个 sandbox，不超过 60 秒。</h2>
      <div class="how-steps">
        <article class="how-step">
          <div class="step-ix" aria-hidden="true">01</div>
          <h3>拉起</h3>
          <p>指定 image / 资源 / 网络策略，Sandbox.create() 返回时，VM 已经在另一端等你。</p>
          <pre class="code-block" tabindex="0"><code><span class="tok-c"># pip install talon-sandbox</span>
<span class="tok-k">from</span> talon_sandbox <span class="tok-k">import</span> Sandbox
sb = <span class="tok-k">await</span> <span class="tok-fn">Sandbox.create</span>(
  image=<span class="tok-s">"node:20-bookworm"</span>,
  resources=&lbrace;<span class="tok-s">"cpu"</span>: 2, <span class="tok-s">"memory"</span>: <span class="tok-s">"4GiB"</span>&rbrace;,
  network=<span class="tok-s">"allowlist"</span>,
)</code></pre>
        </article>

        <article class="how-step">
          <div class="step-ix" aria-hidden="true">02</div>
          <h3>运行</h3>
          <p>把任何命令丢进去 · 拿 PTY 流回你的模型 · 文件读写、进程管理、git 操作全程在 SDK 一行。</p>
          <pre class="code-block" tabindex="0"><code><span class="tok-c"># stream stdout back to your LLM</span>
pty = <span class="tok-k">await</span> sb.terminal.<span class="tok-fn">open</span>()
<span class="tok-k">await</span> pty.<span class="tok-fn">write</span>(<span class="tok-s">"npm run dev\n"</span>)
<span class="tok-k">async for</span> ch <span class="tok-k">in</span> pty:
    llm.<span class="tok-fn">feed</span>(ch)</code></pre>
        </article>

        <article class="how-step">
          <div class="step-ix" aria-hidden="true">03</div>
          <h3>暴露</h3>
          <p>一行代码把端口暴露为公共 preview URL。可加签名、限流、TTL，关闭 sandbox 就回收。</p>
          <pre class="code-block" tabindex="0"><code><span class="tok-c"># instant preview URL</span>
url = <span class="tok-k">await</span> sb.<span class="tok-fn">expose</span>(<span class="tok-s">5173</span>)
<span class="tok-c"># https://sb-42a1-5173.preview.sandbox.talon.net.cn</span>
<span class="tok-fn">print</span>(url)
<span class="tok-c"># auto-cleaned on sandbox.kill()</span></code></pre>
        </article>
      </div>
    </div>
  </section>

  <!-- ───── USE CASES ───── -->
  <section class="cases-section" id="cases">
    <div class="container">
      <div class="eyebrow" style="display:block;text-align:center;margin-bottom:18px">谁在用 Talon Sandbox</div>
      <h2 class="big" style="text-align:center">不同 agent · 同一台计算机</h2>
      <div class="cases-grid">
        <article class="case-card">
          <div class="eyebrow" style="margin:0;font-size:10.5px">CODING AGENT</div>
          <h3>AI 编程助手</h3>
          <p>让 agent 自己 clone 项目 / 装依赖 / 跑测试 / 开 PR。每一步都有终端记录，失败可回放精确到那一行。</p>
          <div class="case-who">acme · raven ai · codex labs</div>
        </article>

        <article class="case-card">
          <div class="eyebrow" style="margin:0;font-size:10.5px">DATA AGENT</div>
          <h3>数据分析 agent</h3>
          <p>Python kernel 跑 pandas / matplotlib，图表通过 expose() 直出。模型看见输出，自己决定下一步。</p>
          <div class="case-who">paper inc. · thread.so · 17 fintech 客户</div>
        </article>

        <article class="case-card">
          <div class="eyebrow" style="margin:0;font-size:10.5px">REVIEW AGENT</div>
          <h3>代码审查 agent</h3>
          <p>CI hook 触发 sandbox · 跑 lint / 静态分析 / 安全扫描 · 直接评论到 PR。完全无服务器维护。</p>
          <div class="case-who">foundation · 多家 YC 公司</div>
        </article>
      </div>
    </div>
  </section>

  <!-- ───── PRICING ───── -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="eyebrow" style="display:block;text-align:center;margin-bottom:18px">价格 · 规划中</div>
      <h2 class="big" style="text-align:center">定价方案规划中</h2>
      <p class="lead" style="text-align:center;margin:0 auto 48px">
        下面是规划中的方案分层。具体价格、配额与 SLA 尚未最终确定，敬请期待。
      </p>
      <div class="tiers-grid">
        <!-- FREE -->
        <article class="tier">
          <div class="tier-name">免费</div>
          <div class="tier-price">
            <span class="tier-num" style="font-size:36px">规划中</span>
          </div>
          <p class="tier-desc">单人原型 · 周末实验 · 自己玩 agent</p>
          <ul class="tier-features" role="list">
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>入门体验额度</li>
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>单 sandbox 资源上限</li>
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>公共 image registry</li>
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>审计 / 录像（限期保留）</li>
            <li class="tier-no"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>无私有 registry</li>
          </ul>
          <div class="tier-cta">
            <a class="btn" style="width:100%;justify-content:center" href="https://docs.sandbox.talon.net.cn" target="_blank" rel="noopener">查看文档</a>
          </div>
        </article>

        <!-- TEAM -->
        <article class="tier tier-featured">
          <span class="tier-badge">规划中</span>
          <div class="tier-name">团队</div>
          <div class="tier-price">
            <span class="tier-num" style="font-size:36px">规划中</span>
          </div>
          <p class="tier-desc">小型 AI 团队 · 创业公司 · 多 agent 协作</p>
          <ul class="tier-features" role="list">
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>更高资源配额</li>
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>私有 registry · 按租户加密</li>
            <li><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5"/></svg>审计 / 录像长期保留</li>
